{
  "name": "Just time",
  "version": "1.0",
  "author": "artur.chlad",
  "description": "App shows just time like watchface",
  "type": "feature",
  "usage": "workout",
  "modificationTime": 1773314833,
  "out": [
    { "name": "hourFont", "shownName": "hourFont" },
    { "name": "minuteFont", "shownName": "minuteFont" },
    { "name": "hourColor", "shownName": "hourColor" },
    { "name": "minuteColor", "shownName": "minuteColor" },
    { "name": "settingMode", "shownName": "settingMode" }
  ],
  "template": [{ "name": "t.html" }, { "name": "u.html" }, { "name": "v.html" }, { "name": "w.html" }],
  "settings": [
    {
      "shownName": "Font type",
      "path": "fontType",
      "type": "enum",
      "values": ["hh-basic mm-basic", "hh-line mm-basic", "hh-basic mm-line", "hh-line mm-line"]
    },
    {
      "shownName": "Hour color",
      "path": "hourColor",
      "type": "enum",
      "values": ["red", "green", "blue", "azure", "yellow", "orange", "grey", "white"]
    },
    {
      "shownName": "Minute color",
      "path": "minuteColor",
      "type": "enum",
      "values": ["red", "green", "blue", "azure", "yellow", "orange", "grey", "white"]
    }
  ],

  "image": [
    { "name": "aod-q.png", "type": "a64" },
    { "name": "font-q.png", "type": "alpha2bit" }
  ]
}
